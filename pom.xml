<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.transformer-from-scratch</groupId>
    <artifactId>transformer-from-scratch</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Transformer From Scratch</name>
    <description>
        A complete implementation of the encoder-decoder Transformer architecture
        (Vaswani et al., 2017) in pure Java 17 with no external ML-framework dependencies.
        Implements the full forward pass including multi-head attention, positional encoding,
        layer normalisation, and autoregressive generation.
    </description>
    <url>https://github.com/your-org/transformer-from-scratch</url>
    <inceptionYear>2024</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/your-org/transformer-from-scratch.git</connection>
        <developerConnection>scm:git:git@github.com:your-org/transformer-from-scratch.git</developerConnection>
        <url>https://github.com/your-org/transformer-from-scratch</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/your-org/transformer-from-scratch/issues</url>
    </issueManagement>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <junit.version>5.10.0</junit.version>
    </properties>

    <dependencies>
        <!-- JUnit Jupiter (JUnit 5) — test scope only -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler plugin: use 'release' instead of source/target for correctness -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Run JUnit 5 tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>

            <!-- exec:java — run Main or any other class -->
            <!-- Usage: mvn "-Dexec.mainClass=transformer.Main" exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>transformer.Main</mainClass>
                </configuration>
            </plugin>

            <!-- Produce a self-contained fat-jar (includes all dependencies) -->
            <!-- Usage: mvn package && java -jar target/transformer-from-scratch-1.0.0-jar-with-dependencies.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>transformer.Main</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>assemble-all</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
